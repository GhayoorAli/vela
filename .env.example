DATABASE_URL="file:./dev.db"
ADMIN_PASSWORD=change-me
ADMIN_SECRET=change-me-too

# Snap Camera Kit — powers the live AR fitting room (/try-on).
# 1. Enable Camera Kit at https://my-lenses.snapchat.com/camera-kit/apps
#    (you'll need a Snapchat account). Copy the Staging API token.
# 2. Copy the Lens Group ID from that same app page. Publish try-on lenses
#    from Lens Studio to the group.
# 3. Paste each product's Lens ID in Admin → Products → "Try-on Lens ID".
CAMERA_KIT_API_TOKEN=
CAMERA_KIT_LENS_GROUP_ID=

# Optional: attach lenses to seeded products when running `npm run db:seed`.
# Format: slug=lensId[@lensGroupId],slug=lensId
TRY_ON_LENSES=
