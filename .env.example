# Local Docker: docker compose up -d
# Then: npm run db:push && npm run db:seed
# Host port 5433 maps to Postgres 5432 inside the container.
#
# Production (Vercel + Neon):
# DATABASE_URL = pooled connection (host contains -pooler)
# DIRECT_URL   = direct connection (used by prisma db push / migrate)
DATABASE_URL="postgresql://vela:vela@localhost:5433/vela"
DIRECT_URL="postgresql://vela:vela@localhost:5433/vela"

ADMIN_PASSWORD=change-me
ADMIN_SECRET=change-me-too

# Snap Camera Kit — powers the live AR fitting room (/try-on).
# 1. Enable Camera Kit at https://my-lenses.snapchat.com/camera-kit/apps
#    (you'll need a Snapchat account). Copy the Staging API token.
# 2. Copy the Lens Group ID from that same app page. Publish try-on lenses
#    from Lens Studio to the group.
# 3. Paste each product's Lens ID in Admin → Products → "Try-on Lens ID".
CAMERA_KIT_API_TOKEN=
CAMERA_KIT_LENS_GROUP_ID=

# Optional: attach lenses to seeded products when running `npm run db:seed`.
# Format: slug=lensId[@lensGroupId],slug=lensId
TRY_ON_LENSES=

# OpenAI — powers Ask the stylist, product “styled for you”, and bag completions.
# Create a key at https://platform.openai.com/api-keys
# Without this, recommendations still appear using the in-house catalog rules.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
